{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kairoseth.com/schemas/site-manager-command-v1.schema.json",
  "title": "Site Manager governed command v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "command_id",
    "site",
    "action",
    "requested_by",
    "payload"
  ],
  "properties": {
    "version": {
      "const": "1"
    },
    "command_id": {
      "type": "string",
      "pattern": "^cmd-[a-z0-9][a-z0-9-]{7,63}$"
    },
    "site": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "action": {
      "enum": [
        "site.read",
        "site.diagnostics",
        "content.update",
        "content.acceptance",
        "navigation.update",
        "seo.update",
        "navigation.acceptance",
        "seo.acceptance",
        "site.overview",
        "site.content_targets"
      ]
    },
    "requested_by": {
      "const": "chatgpt"
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "content.update"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "stage",
                  "post_id",
                  "fields"
                ],
                "properties": {
                  "stage": {
                    "const": "plan"
                  },
                  "post_id": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "fields": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": false,
                    "properties": {
                      "title": {
                        "type": "string",
                        "maxLength": 500
                      },
                      "slug": {
                        "type": "string",
                        "maxLength": 200
                      },
                      "content": {
                        "type": "string",
                        "maxLength": 200000
                      },
                      "excerpt": {
                        "type": "string",
                        "maxLength": 20000
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "draft",
                          "publish",
                          "private",
                          "pending"
                        ]
                      }
                    }
                  },
                  "reason": {
                    "type": "string",
                    "maxLength": 500
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "stage",
                  "plan_id",
                  "confirmed"
                ],
                "properties": {
                  "stage": {
                    "const": "apply"
                  },
                  "plan_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "pattern": "^[A-Za-z0-9_-]+$"
                  },
                  "confirmed": {
                    "const": true
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "stage",
                  "plan_id",
                  "confirmed"
                ],
                "properties": {
                  "stage": {
                    "const": "rollback"
                  },
                  "plan_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "pattern": "^[A-Za-z0-9_-]+$"
                  },
                  "confirmed": {
                    "const": true
                  }
                }
              }
            ]
          }
        }
      },
      "else": {
        "if": {
          "properties": {
            "action": {
              "const": "content.acceptance"
            }
          },
          "required": [
            "action"
          ]
        },
        "then": {
          "properties": {
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "confirmed"
              ],
              "properties": {
                "confirmed": {
                  "const": true
                }
              }
            }
          }
        },
        "else": {
          "if": {
            "properties": {
              "action": {
                "const": "navigation.update"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "stage",
                      "provider",
                      "target_id",
                      "fields"
                    ],
                    "properties": {
                      "stage": {
                        "const": "plan"
                      },
                      "provider": {
                        "const": "wordpress-classic-menu"
                      },
                      "target_id": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "fields": {
                        "type": "object",
                        "minProperties": 1,
                        "additionalProperties": false,
                        "properties": {
                          "title": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 500
                          },
                          "url": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096
                          },
                          "description": {
                            "type": "string",
                            "maxLength": 5000
                          },
                          "attr_title": {
                            "type": "string",
                            "maxLength": 500
                          },
                          "target": {
                            "type": "string",
                            "enum": [
                              "",
                              "_blank"
                            ]
                          },
                          "classes": {
                            "oneOf": [
                              {
                                "type": "string",
                                "maxLength": 2000
                              },
                              {
                                "type": "array",
                                "maxItems": 50,
                                "items": {
                                  "type": "string",
                                  "maxLength": 100
                                }
                              }
                            ]
                          },
                          "xfn": {
                            "type": "string",
                            "maxLength": 2000
                          }
                        }
                      },
                      "reason": {
                        "type": "string",
                        "maxLength": 500
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "stage",
                      "provider",
                      "target_id",
                      "fields"
                    ],
                    "properties": {
                      "stage": {
                        "const": "plan"
                      },
                      "provider": {
                        "const": "wordpress-block-navigation"
                      },
                      "target_id": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "fields": {
                        "type": "object",
                        "minProperties": 1,
                        "additionalProperties": false,
                        "properties": {
                          "title": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 500
                          },
                          "content": {
                            "type": "string",
                            "maxLength": 200000
                          },
                          "status": {
                            "type": "string",
                            "enum": [
                              "draft",
                              "publish"
                            ]
                          }
                        }
                      },
                      "reason": {
                        "type": "string",
                        "maxLength": 500
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "stage",
                      "plan_id",
                      "confirmed"
                    ],
                    "properties": {
                      "stage": {
                        "const": "apply"
                      },
                      "plan_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "^[A-Za-z0-9_-]+$"
                      },
                      "confirmed": {
                        "const": true
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "stage",
                      "plan_id",
                      "confirmed"
                    ],
                    "properties": {
                      "stage": {
                        "const": "rollback"
                      },
                      "plan_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "^[A-Za-z0-9_-]+$"
                      },
                      "confirmed": {
                        "const": true
                      }
                    }
                  }
                ]
              }
            }
          },
          "else": {
            "if": {
              "properties": {
                "action": {
                  "const": "seo.update"
                }
              },
              "required": [
                "action"
              ]
            },
            "then": {
              "properties": {
                "payload": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "stage",
                        "post_id",
                        "fields"
                      ],
                      "properties": {
                        "stage": {
                          "const": "plan"
                        },
                        "post_id": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "fields": {
                          "type": "object",
                          "minProperties": 1,
                          "additionalProperties": false,
                          "properties": {
                            "title": {
                              "type": "string",
                              "maxLength": 500
                            },
                            "description": {
                              "type": "string",
                              "maxLength": 5000
                            },
                            "canonical": {
                              "type": "string",
                              "maxLength": 4096
                            },
                            "indexability": {
                              "type": "string",
                              "enum": [
                                "default",
                                "index",
                                "noindex"
                              ]
                            }
                          }
                        },
                        "reason": {
                          "type": "string",
                          "maxLength": 500
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "stage",
                        "plan_id",
                        "confirmed"
                      ],
                      "properties": {
                        "stage": {
                          "const": "apply"
                        },
                        "plan_id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200,
                          "pattern": "^[A-Za-z0-9_-]+$"
                        },
                        "confirmed": {
                          "const": true
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "stage",
                        "plan_id",
                        "confirmed"
                      ],
                      "properties": {
                        "stage": {
                          "const": "rollback"
                        },
                        "plan_id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200,
                          "pattern": "^[A-Za-z0-9_-]+$"
                        },
                        "confirmed": {
                          "const": true
                        }
                      }
                    }
                  ]
                }
              }
            },
            "else": {
              "if": {
                "properties": {
                  "action": {
                    "const": "navigation.acceptance"
                  }
                },
                "required": [
                  "action"
                ]
              },
              "then": {
                "properties": {
                  "payload": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "confirmed"
                    ],
                    "properties": {
                      "confirmed": {
                        "const": true
                      }
                    }
                  }
                }
              },
              "else": {
                "if": {
                  "properties": {
                    "action": {
                      "const": "seo.acceptance"
                    }
                  },
                  "required": [
                    "action"
                  ]
                },
                "then": {
                  "properties": {
                    "payload": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "confirmed"
                      ],
                      "properties": {
                        "confirmed": {
                          "const": true
                        }
                      }
                    }
                  }
                },
                "else": {
                  "properties": {
                    "payload": {
                      "type": "object",
                      "additionalProperties": false,
                      "maxProperties": 0
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}

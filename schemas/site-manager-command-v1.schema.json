{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kairoseth.com/schemas/site-manager-command-v1.schema.json",
  "title": "Site Manager governed command v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "command_id", "site", "action", "requested_by", "payload"],
  "properties": {
    "version": {"const": "1"},
    "command_id": {
      "type": "string",
      "pattern": "^cmd-[a-z0-9][a-z0-9-]{7,63}$"
    },
    "site": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "action": {
      "enum": ["site.read", "site.diagnostics"]
    },
    "requested_by": {"const": "chatgpt"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    }
  }
}

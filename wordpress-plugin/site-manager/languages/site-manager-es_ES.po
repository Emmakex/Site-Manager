msgid "Site Manager Dashboard"
msgstr "Panel de Site Manager"

msgid "Site Manager"
msgstr "Site Manager"

msgid "Dashboard"
msgstr "Panel"

msgid "You do not have permission to access Site Manager."
msgstr "No tienes permisos para acceder a Site Manager."

msgid "This installation was discovered automatically. Detection describes the site; it does not grant write access."
msgstr "Esta instalación se ha descubierto automáticamente. La detección describe el sitio; no concede permisos de escritura."

msgid "Last discovery:"
msgstr "Último descubrimiento:"

msgid "Generation:"
msgstr "Generación:"

msgid "Re-detect site"
msgstr "Volver a detectar el sitio"

msgid "Discovered"
msgstr "Detectado"


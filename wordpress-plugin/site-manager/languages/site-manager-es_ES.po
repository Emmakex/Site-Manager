msgstr "PHP"

msgid "Theme"
msgstr "Tema"

msgid "Content types"
msgstr "Tipos de contenido"

msgid "Taxonomies"
msgstr "Taxonomías"

msgid "Active plugins"
msgstr "Plugins activos"

msgid "Navigation"
msgstr "Navegación"

msgid "No native navigation provider detected."
msgstr "No se ha detectado ningún proveedor de navegación nativa."

msgid "WordPress classic menus"
msgstr "Menús clásicos de WordPress"

msgid "WordPress block navigation"
msgstr "Navegación por bloques de WordPress"

msgid "%1$s (%2$d targets)"
msgstr "%1$s (%2$d objetivos)"

msgid "SEO ownership"
msgstr "Propiedad SEO"

msgid "SEO ownership evidence"
msgstr "Evidencia de propiedad SEO"

msgid "Owned SEO outputs:"
msgstr "Salidas SEO bajo propiedad:"

msgid "Ownership detection is read-only. A detected owner or declared provider contract never grants SEO write access by itself."
msgstr "La detección de propiedad es de solo lectura. Detectar un propietario o un contrato de proveedor declarado nunca concede por sí solo permisos de escritura SEO."

msgid "SEO owner not resolved"
msgstr "Propietario SEO no resuelto"

msgid "Conflict: %d SEO ownership candidates"
msgstr "Conflicto: %d candidatos a propietario SEO"

msgid "%s · ownership resolved · write adapter pending"
msgstr "%s · propiedad resuelta · adaptador de escritura pendiente"

msgid "Registered SEO meta candidates: %1$d · SEO-related hooks: %2$d · matched provider contracts: %3$d"
msgstr "Metadatos SEO registrados candidatos: %1$d · hooks relacionados con SEO: %2$d · contratos de proveedor coincidentes: %3$d"

msgid "Fingerprint"
msgstr "Huella estructural"

msgid "Known providers detected"
msgstr "Proveedores conocidos detectados"

msgid "No known provider plugin detected."
msgstr "No se ha detectado ningún plugin proveedor conocido."

msgid "Provider"
msgstr "Proveedor"

msgid "Version"
msgstr "Versión"

msgid "State"
msgstr "Estado"

msgid "DETECTED"
msgstr "DETECTADO"

msgid "Capability map"
msgstr "Mapa de capacidades"

msgid "Detected %1$d · Understood %2$d · Governable %3$d · Authorized %4$d · Blocked %5$d"
msgstr "Detectadas %1$d · Comprendidas %2$d · Gobernables %3$d · Autorizadas %4$d · Bloqueadas %5$d"

msgid "Missing to govern"
msgstr "Pendiente para gobernar"

msgid "No governance gaps detected."
msgstr "No se han detectado carencias de gobernanza."

msgid "The safe WordPress Core write adapter is not implemented yet."
msgstr "El adaptador seguro de escritura de WordPress Core todavía no está implementado."

msgid "Navigation ownership and rollback are not implemented yet."
msgstr "La propiedad de navegación y el rollback todavía no están implementados."

msgid "No native WordPress navigation provider was detected."
msgstr "No se ha detectado ningún proveedor de navegación nativa de WordPress."

msgid "Native WordPress navigation was detected but no existing target is safely governable yet."
msgstr "Se ha detectado navegación nativa de WordPress, pero todavía no existe ningún objetivo que pueda gobernarse de forma segura."

msgid "SEO ownership could not be resolved from the current WordPress runtime."
msgstr "No se ha podido resolver la propiedad SEO a partir del entorno actual de WordPress."

msgid "Multiple SEO ownership candidates were detected; writes remain blocked until the conflict is resolved."
msgstr "Se han detectado varios candidatos a propietario SEO; las escrituras seguirán bloqueadas hasta resolver el conflicto."

msgid "SEO ownership is understood, but no verified safe write path is available."
msgstr "La propiedad SEO está comprendida, pero todavía no existe una vía de escritura segura verificada."

msgid "SEO ownership is resolved to %s, but its write adapter is not ready."
msgstr "La propiedad SEO está resuelta a %s, pero su adaptador de escritura todavía no está listo."

msgid "Provider detected; a dedicated adapter is required before governance is exposed."
msgstr "Proveedor detectado; se necesita un adaptador dedicado antes de habilitar su gobernanza."

msgid "Forbidden"
msgstr "Prohibido"

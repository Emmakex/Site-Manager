# Public REST base shown in WordPress under Site Manager > Connection.
SITE_MANAGER_REST_BASE=https://example.com/wp-json/site-manager/v1/

# Non-secret connection id shown in WordPress (smc_...).
SITE_MANAGER_CONNECTION_ID=smc_replace_me

# Secret one-time token generated by Site Manager.
# Store this only in the operator-owned .env/deployment secret store.
# Never commit or paste a real value into documentation or chat.
SITE_MANAGER_TOKEN=replace_with_secret

# Host-side port. compose.yaml binds it to 127.0.0.1 by default.
SITE_MANAGER_MCP_BIND_PORT=8787

# Runtime-internal values. Compose pins HOST/PORT for the container.
SITE_MANAGER_TIMEOUT_MS=10000

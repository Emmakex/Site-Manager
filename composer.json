{
  "name": "site-manager/core",
  "description": "Platform-neutral discovery and governance core for Site Manager.",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": ">=8.1"
  },
  "autoload": {
    "psr-4": {
      "SiteManager\\Core\\": "src/Core/",
      "SiteManager\\Adapters\\WordPress\\": "src/Adapters/WordPress/"
    }
  },
  "scripts": {
    "test": [
      "@php tests/core_contract_test.php",
      "@php tests/wordpress_adapter_contract_test.php",
      "@php tests/wordpress_content_governance_test.php",
      "@php tests/wordpress_navigation_governance_test.php",
      "@php tests/wordpress_seo_ownership_test.php",
      "@php tests/wordpress_theme_seo_contract_inspector_test.php",
      "@php tests/wordpress_seo_data_source_tracer_test.php",
      "@php tests/wordpress_seo_provider_readiness_test.php",
      "@php tests/wordpress_seo_provider_registry_test.php",
      "@php tests/wordpress_seo_semantic_governance_test.php"
    ],
    "lint": [
      "@php scripts/lint.php"
    ]
  }
}
